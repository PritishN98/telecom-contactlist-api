{
	"info": {
		"_postman_id": "c71a39f0-8c29-4d6b-9c60-84a28f86f874",
		"name": "Telecom Domain - Contact List API Testing",
		"description": "Comprehensive API Testing for Contact List Application (https://thinking-tester-contact-list.herokuapp.com/) with Chai library assertions.",
