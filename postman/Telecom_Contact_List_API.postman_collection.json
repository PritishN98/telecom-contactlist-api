	"item": [
		{
			"name": "Test Case 1: Add New User",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const randomId = Math.floor(Math.random() * 100000);",
							"pm.environment.set(\"userEmail\", \"testuser_\" + randomId + \"@fake.com\");"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Token is generated and stored in environment\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property(\"token\");",
							"    pm.expect(jsonData.token).to.be.a(\"string\").and.not.empty;",
							"    pm.environment.set(\"token\", jsonData.token);",
							"});",
							"",
							"pm.test(\"User response matches request payload\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.user.firstName).to.eql(\"Test\");",
							"    pm.expect(jsonData.user.lastName).to.eql(\"User\");",
							"    pm.expect(jsonData.user.email).to.eql(pm.environment.get(\"userEmail\"));",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"myPassword\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/users",
					"host": ["{{baseUrl}}"],
					"path": ["users"]
				}
			}
		},
